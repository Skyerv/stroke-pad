{
  "name": "stroke-pad",
  "version": "0.1.0",
  "private": true,
  "description": "Local Electron app for generating Hanzi practice sheets",
  "main": "apps/desktop/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "generate:hsk": "node scripts/generate-hsk-data.js",
    "build:web-data": "node scripts/build-web-data.js",
    "dev:web": "vite",
    "build:web": "npm run build:web-data && vite build",
    "preview:web": "vite preview",
    "build": "electron-builder"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "electron": "^37.3.1",
    "electron-builder": "^26.8.1",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.strokepad.app",
    "productName": "StrokePad",
    "directories": {
      "buildResources": "apps/desktop/assets"
    },
    "files": [
      "apps/desktop/**/*",
      "core/**/*",
      "data/hanzi/**/*",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "apps/desktop/assets/icon.png"
    }
  }
}
